@model Library_Manager.Models.TDinhDang

@{
    ViewData["Title"] = "Chi tiết định dạng";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h1>Chi tiết</h1>

    <div>
        <h4>TDinhDang</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.MaDd)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.MaDd)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.TenDd)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.TenDd)
            </dd>
        </dl>
    </div>

    <div>
        <a asp-action="Edit" asp-route-id="@Model?.MaDd" class="btn btn-primary">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại danh sách</a>
    </div>
</div>
