@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<Library_Manager.Models.TDinhDang>

@{
    ViewData["Title"] = "Định dạng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <partial name="_DanhMuc" />
    <h1>Danh sách định dạng</h1>
    <partial name="SearchBar" />

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>

    <div class="table-responsive-scroll">
        <table class="table table-bordered table-responsive text-nowrap">
            <thead>
                <tr>
                    <th>
                        Tên định dạng
                    </th>
                    <th style="min-width: 150px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.TenDd)
                        </td>
                        <td style="min-width: 150px">
                            <a asp-action="Edit" asp-route-id="@item.MaDd">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.MaDd">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.MaDd">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <partial name="_Pagination" />
    </div>
</div>
