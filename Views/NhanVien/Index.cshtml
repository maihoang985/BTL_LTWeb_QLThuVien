@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<Library_Manager.Models.TNhanVien>

@{
    ViewData["Title"] = "Danh sách nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h1 class="mb-3">Danh sách nhân viên</h1>

    <!-- Thanh tìm kiếm -->
    <partial name="SearchBar" />

    <!-- Nút thêm mới -->
    <p>
        <a class="btn btn-success" asp-action="Create">+ Thêm nhân viên</a>
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-nowrap align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã NV</th>
                    <th>Họ đệm</th>
                    <th>Tên</th>
                    <th>Ngày sinh</th>
                    <th>Giới tính</th>
                    <th>Địa chỉ</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Phụ trách</th>
                    <th style="min-width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var nv in Model)
                    {
                        <tr>
                            <td>@nv.MaNv</td>
                            <td>@nv.HoDem</td>
                            <td>@nv.Ten</td>
                            <td>@(nv.NgaySinh.ToString("dd/MM/yyyy"))</td>
                            <td>@(nv.GioiTinh == "M" ? "Nam" : nv.GioiTinh == "F" ? "Nữ" : "-")</td>
                            <td>@nv.DiaChi</td>
                            <td>@nv.Sdt</td>
                            <td>@nv.Email</td>
                            <td>@nv.PhuTrach</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@nv.MaNv">Sửa</a> |
                                <a asp-action="Details" asp-route-id="@nv.MaNv">Chi tiết</a> |
                                <a asp-action="Delete" asp-route-id="@nv.MaNv">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted">Không có dữ liệu</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang -->
        <partial name="_Pagination" />
    </div>
</div>
