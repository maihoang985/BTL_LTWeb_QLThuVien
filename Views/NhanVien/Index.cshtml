@* ========================================================================
   KHỐI 1: KHAI BÁO MODEL VÀ VIEWDATA
   ======================================================================== *@
@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<Library_Manager.Models.TNhanVien>

@{
    ViewData["Title"] = "Quản lý Nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userRole = Context.Session.GetString("UserRole");
    // Giả định "QTV" (Quản trị viên) và "QLNV" (Quản lý Nhân viên) có quyền chỉnh sửa
    bool canEdit = (userRole == "QTV" || userRole == "QLNV");
}

@* ========================================================================
   KHỐI 2: CẤU TRÚC BỐ CỤC CHÍNH (CONTAINER)
   ======================================================================== *@
<div class="container-xxl flex-grow-1 container-p-y">

    @* --- PHẦN 2.1: TIÊU ĐỀ TRANG --- *@
    <h1 class="fw-bold text-primary mb-4">
        <i class='bx bx-user-pin fa-border fs-1 me-2'></i> Quản lý Nhân viên
    </h1>

    <div class="card">
        @* --- PHẦN 2.2: THANH TÁC VỤ (SEARCH & CREATE) --- *@
        <div class="card-header border-bottom">
            <div class="d-flex justify-content-between align-items-center">

                @* Thanh Tìm kiếm (SearchBar Partial) - Chiếm phần lớn không gian *@
                <div class="flex-grow-1 me-3">
                    <partial name="SearchBar" />
                </div>

                @* Nút Thêm mới - Cố định bên phải *@
                <div class="flex-shrink-0 ">
                    <p class="m-0">
                        <a asp-action="Create" class="btn btn-primary text-nowrap @(canEdit ? "" : "disabled")">
                            <i class="bx bx-plus me-1"></i> Thêm Nhân viên
                        </a>
                    </p>
                </div>
            </div>
        </div>

        @* ========================================================================
           KHỐI 3: BẢNG DỮ LIỆU VÀ PHÂN TRANG
           ======================================================================== *@
        <div class="table-responsive">
            <table class="table table-bordered text-nowrap table-hover" id="myTable">

                @* --- PHẦN 3.1: TIÊU ĐỀ BẢNG (THEAD) --- *@
                <thead id="myTableHead">
                    <tr>
                        <th>Mã NV</th>
                        <th style="white-space: nowrap;">Họ Đệm</th>
                        <th>Tên</th>
                        <th>Ngày Sinh</th>
                        <th style="white-space: nowrap;">Giới Tính</th>
                        <th>SĐT</th>
                        <th>Email</th>
                        <th style="min-width: 120px;">Hành động</th>
                    </tr>
                </thead>

                @* --- PHẦN 3.2: NỘI DUNG BẢNG (TBODY) --- *@
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaNv</td>
                                <td style="white-space: nowrap;">@item.HoDem</td>
                                <td>@item.Ten</td>
                                <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                                <td style="white-space: nowrap;">
                                    @{
                                        var gioiTinh = (item.GioiTinh == "M" ? "Nam" : item.GioiTinh == "F" ? "Nữ" : "-");
                                        var badgeClass = gioiTinh == "Nam" ? "bg-label-info" :
                                        gioiTinh == "Nữ" ? "bg-label-danger" :
                                        "bg-label-secondary";
                                    }
                                    <span class="badge @badgeClass">
                                        @gioiTinh
                                    </span>
                                </td>
                                <td>@item.Sdt</td>
                                <td>@item.Email</td>
                                <td>
                                    <div class="d-flex w-100 justify-content-start">

                                        @* 1. Chi tiết (Details) *@
                                        <a asp-action="Details" asp-route-id="@item.MaNv"
                                           class="btn btn-icon btn-label-info waves-effect me-1"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="Chi tiết">
                                            <i class='bx bx-detail'></i>
                                        </a>

                                        @* 2. Sửa (Edit) *@
                                        <a asp-action="Edit" asp-route-id="@item.MaNv"
                                           class="btn btn-icon btn-label-primary waves-effect me-1 @(canEdit ? "" : "disabled")"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="Sửa">
                                            <i class='bx bx-pencil'></i>
                                        </a>

                                        @* 3. Xóa (Delete) *@
                                        <a asp-action="Delete" asp-route-id="@item.MaNv"
                                           class="btn btn-icon btn-label-danger waves-effect @(canEdit ? "" : "disabled")"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="Xóa">
                                            <i class='bx bx-trash'></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">Không có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- PHẦN 3.3: PHÂN TRANG (PAGINATION) --- *@
        <div class="card-footer pt-0">
            <partial name="_Pagination" />
        </div>
    </div>
</div>

