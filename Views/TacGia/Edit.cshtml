@model Library_Manager.Models.TTacGia

@{
    // Đặt tiêu đề cho trang
    ViewData["Title"] = "Chỉnh sửa Tác giả: " + Model.HoDem + " " + Model.Ten;

    // Logic kiểm tra quyền chỉnh sửa (Giả định QTV/QLS có quyền)
    var userRole = Context.Session.GetString("UserRole");
    bool canEdit = (userRole == "QTV" || userRole == "QLS");
}

@* ========================================================================
   KHỐI 1: CẤU TRÚC BỐ CỤC CHÍNH (CONTAINER)
   ======================================================================== *@
<div class="container-xxl flex-grow-1 container-p-y">

    @* --- PHẦN 1.1: TIÊU ĐỀ TRANG --- *@
    <h1 class="fw-bold text-primary mb-4">
        <i class='bx bx-pencil fs-2 me-2'></i> Chỉnh sửa Tác giả
    </h1>

    @* --- KHỐI: CARD BAO QUANH FORM --- *@
    <div class="card">

        @* HEADER CỦA CARD: Hiển thị tên Tác giả đang chỉnh sửa *@
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                Chỉnh sửa thông tin Tác giả: <span class="text-primary fw-bold">@Model.HoDem @Model.Ten</span>
            </h5>
            <small class="text-muted">Mã TG: <span class="fw-bold">@Model.MaTg</span></small>
        </div>

        @* FORM BẮT ĐẦU *@
        <form asp-action="Edit">
            @* BODY CỦA CARD: CHỨA CÁC TRƯỜNG DỮ LIỆU *@
            <div class="card-body">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* Mã TG được lưu dưới dạng Hidden Field *@
                <input type="hidden" asp-for="MaTg" />

                <div class="row">
                    @* 1. Mã Tác giả (Chỉ hiển thị, không sửa) *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Mã Tác giả</label>
                            @* Hiển thị MaTg dưới dạng không sửa đổi (disabled) *@
                            <input value="@Model.MaTg" class="form-control" disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    @* 2. Họ Đệm *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="HoDem" class="form-label">Họ Đệm</label>
                            <input asp-for="HoDem" class="form-control" />
                            <span asp-validation-for="HoDem" class="text-danger"></span>
                        </div>
                    </div>

                    @* 3. Tên *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Ten" class="form-label">Tên</label>
                            <input asp-for="Ten" class="form-control" />
                            <span asp-validation-for="Ten" class="text-danger"></span>
                        </div>
                    </div>
                </div>

            </div>

            @* FOOTER CỦA CARD: Chứa các nút Hành động *@
            <div class="card-footer border-top pt-3">
                <div class="d-flex gap-3">
                    @* Nút Lưu *@
                    <button type="submit" value="Save" class="btn btn-primary @(canEdit ? "" : "disabled")">
                        <i class="bx bx-save me-1"></i> Lưu thay đổi
                    </button>

                    @* Nút Quay lại *@
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
