@model Library_Manager.Models.TTacGia

@{
    ViewData["Title"] = "Chỉnh sửa Tác giả";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <h1 class="fw-bold text-primary mb-4">
        <i class='bx bx-pencil fs-2 me-2 border p-1 rounded-2'></i> Chỉnh sửa thông tin Tác giả
    </h1>

    @* 1. Vị trí hiển thị thông báo *@
    <div id="alertPlaceholder"></div>

    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title mb-0">Chỉnh sửa thông tin cho: <span class="text-info fw-bold">@Model.HoDem @Model.Ten</span></h5>
        </div>

        <form asp-action="Edit" id="editTacGiaForm">
            <div class="card-body">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <input type="hidden" asp-for="MaTg" />

                <div class="row">
                    <div class="col-md-12">
                        @* Họ đệm *@
                        <div class="mb-3">
                            <label asp-for="HoDem" class="form-label">Họ đệm</label>
                            <input asp-for="HoDem" class="form-control" />
                            <span asp-validation-for="HoDem" class="text-danger"></span>
                        </div>

                        @* Tên *@
                        <div class="mb-3">
                            <label asp-for="Ten" class="form-label">Tên</label>
                            <input asp-for="Ten" class="form-control" />
                            <span asp-validation-for="Ten" class="text-danger"></span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card-footer border-top pt-3">
                <div class="d-flex justify-content-between">

                    <div>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bx bx-arrow-back me-1"></i> Quay lại danh sách
                        </a>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="submitButton">
                            <i class="bx bx-save me-1"></i> Lưu thay đổi
                        </button>

                        <a asp-action="Details" asp-route-id="@Model?.MaTg" class="btn btn-success">
                            <i class="bx bx-detail me-1"></i> Xem chi tiết
                        </a>
                    </div>

                </div>
            </div>

        </form>
    </div>
</div>


@* 2. Toàn bộ khối Script cho thông báo *@
@section Scripts {
    <script>
        // Hàm hiển thị thông báo (Toast)
        function showToast(message, type = 'success') {
            const alertPlaceholder = document.getElementById('alertPlaceholder');
            alertPlaceholder.innerHTML = '';

            const wrapper = document.createElement('div');
            wrapper.innerHTML = [
                `<div class="alert alert-${type} alert-dismissible" role="alert">`,
                `  <div>${message}</div>`,
                '  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>',
                '</div>'
            ].join('');

            alertPlaceholder.appendChild(wrapper);
            // Tự động ẩn sau 5 giây
            setTimeout(() => {
                $(wrapper).alert('close');
            }, 5000);
        }

        document.addEventListener('DOMContentLoaded', function () {

            // ==========================================================
            // LOGIC FORM SUBMIT (Kiểm tra và báo cáo kết quả)
            // ==========================================================
            const editForm = document.getElementById('editTacGiaForm');
            const submitButton = document.getElementById('submitButton');

            // 1. Logic chặn submit và đổi text nút
            if (editForm && submitButton) {
                editForm.addEventListener('submit', function (e) {
                    // Kiểm tra validation client-side
                    if ($(editForm).valid()) {
                        // Vô hiệu hóa nút Submit
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang lưu...';
                    }
                });
            }

            // 2. Logic hiển thị thông báo từ TempData
            @if (TempData["StatusMessage"] != null && TempData["Message"] != null)
            {
                    <text>
                        setTimeout(function() {
                            // Hiển thị toast
                            showToast('@Html.Raw(TempData["Message"])', '@TempData["StatusMessage"]');

                            // Kích hoạt lại nút submit nếu có lỗi
                            if ('@TempData["StatusMessage"]' === 'danger' && submitButton) {
                                submitButton.disabled = false;
                                submitButton.innerHTML = '<i class="bx bx-save me-1"></i> Lưu thay đổi';
                            }
                        }, 10);
                    </text>
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}