@model Library_Manager.Models.TGiaoDichMuonTra

@{
    ViewData["Title"] = "Tạo mới Giao dịch Mượn/Trả";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ========================================================================
    KHỐI 1: CẤU TRÚC BỐ CỤC CHÍNH (CONTAINER)
    ======================================================================== *@
<div class="container-xxl flex-grow-1 container-p-y">

    @* --- PHẦN 1.1: TIÊU ĐỀ TRANG --- *@
    <h1 class="fw-bold text-primary mb-4">
        <i class='bx bx-plus fs-2 me-2 border p-1 rounded-2'></i> @ViewData["Title"]
    </h1>

    @* --- KHỐI: CARD BAO QUANH BIỂU MẪU --- *@
    <div class="card">

        @* HEADER CỦA CARD: Tiêu đề cố định *@
        <div class="card-header border-bottom">
            <h5 class="card-title mb-0">Nhập thông tin giao dịch mới</h5>
        </div>

        <form asp-action="Create">
            @* BODY CỦA CARD: Chứa Biểu mẫu nhập liệu *@
            <div class="card-body">

                @* Phần hiển thị lỗi tổng thể *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                @* CHIA BIỂU MẪU THÀNH 2 CỘT *@
                <div class="row">

                    @* --- CỘT 1: THÔNG TIN CHÍNH (6/12) --- *@
                    <div class="col-md-6 pt-3">
                        <h6 class="text-muted text-uppercase mb-3 mt-0">
                            <i class='bx bx-info-circle me-1'></i> Thông tin chính
                        </h6>

                        @* Mã Giao dịch *@
                        <div class="mb-3">
                            <label asp-for="MaGd" class="form-label">Mã Giao dịch</label>
                            <input asp-for="MaGd" class="form-control" />
                            <span asp-validation-for="MaGd" class="text-danger"></span>
                        </div>

                        @* Thẻ Bạn đọc (Select) *@
                        <div class="mb-3">
                            <label asp-for="MaTbd" class="form-label">Thẻ Bạn đọc</label>
                            <select asp-for="MaTbd" class="form-select" asp-items="ViewBag.MaTbd">
                                <option value="">-- Chọn Thẻ Bạn đọc --</option>
                            </select>
                            <span asp-validation-for="MaTbd" class="text-danger"></span>
                        </div>

                        @* Tài khoản (Nhân viên) (Select) *@
                        <div class="mb-3">
                            <label asp-for="MaTk" class="form-label">Tài khoản (Nhân viên)</label>
                            <select asp-for="MaTk" class="form-select" asp-items="ViewBag.MaTk">
                                <option value="">-- Chọn Tài khoản --</option>
                            </select>
                            <span asp-validation-for="MaTk" class="text-danger"></span>
                        </div>

                        @* Trạng Thái (Select) *@
                        <div class="mb-3">
                            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="Đang mượn">Đang mượn</option>
                                <option value="Đã trả">Đã trả</option>
                                <option value="Quá hạn">Quá hạn</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger"></span>
                        </div>
                    </div>

                    @* --- CỘT 2: THỜI GIAN (6/12) --- *@
                    <div class="col-md-6 pt-3">
                        <h6 class="text-muted text-uppercase mb-3 mt-0">
                            <i class='bx bx-calendar me-1'></i> Thời gian
                        </h6>

                        @* Ngày Mượn *@
                        <div class="mb-3">
                            <label asp-for="NgayMuon" class="form-label">Ngày Mượn</label>
                            <input asp-for="NgayMuon" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NgayMuon" class="text-danger"></span>
                        </div>

                        @* Ngày Hẹn Trả *@
                        <div class="mb-3">
                            <label asp-for="NgayHenTra" class="form-label">Ngày Hẹn Trả</label>
                            <input asp-for="NgayHenTra" class="form-control" type="date" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NgayHenTra" class="text-danger"></span>
                        </div>

                        @* Ngày Trả (Thực tế) - Thường là null khi tạo mới *@
                        <div class="mb-3">
                            <label asp-for="NgayTra" class="form-label">Ngày Trả (Thực tế)</label>
                            <input asp-for="NgayTra" class="form-control" type="date" />
                            <span asp-validation-for="NgayTra" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div> @* End card-body *@

            @* FOOTER CỦA CARD: Nút Tạo mới và Quay lại *@
            <div class="card-footer border-top pt-3">
                <div class="d-flex justify-content-start gap-3">

                    @* NÚT TẠO MỚI *@
                    <button type="submit" value="Create" class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i> Tạo mới
                    </button>

                    @* NÚT QUAY LẠI DANH SÁCH *@
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </form>
    </div> @* End card *@
</div> @* End container-xxl *@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

