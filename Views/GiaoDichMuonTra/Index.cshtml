@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<Library_Manager.Models.TGiaoDichMuonTra>

@{
    ViewData["Title"] = "Danh sách giao dịch mượn trả";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h1 class="mb-3">Danh sách giao dịch mượn trả</h1>

    <partial name="SearchBar" />

    <p>
        <a class="btn btn-success" asp-action="Create">+ Thêm giao dịch</a>
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-nowrap align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ngày mượn</th>
                    <th>Ngày hẹn trả</th>
                    <th>Ngày trả</th>
                    <th>Trạng thái</th>
                    <th>Thẻ bạn đọc</th>
                    <th>Tài khoản</th>
                    <th style="min-width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NgayMuon.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayHenTra.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayTra?.ToString("dd/MM/yyyy")</td>
                            <td>@item.TrangThai</td>
                            <td>@item.MaTbdNavigation?.MaTbd</td>
                            <td>@item.MaTkNavigation?.MaTk</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.MaGd">Sửa</a> |
                                <a asp-action="Details" asp-route-id="@item.MaGd">Chi tiết</a> |
                                <a asp-action="Delete" asp-route-id="@item.MaGd">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Không có dữ liệu</td>
                    </tr>
                }
            </tbody>
        </table>

        <partial name="_Pagination" />
    </div>
</div>
