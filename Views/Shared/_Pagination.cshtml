<div class="d-flex justify-content-between align-items-center mt-3">
    <nav aria-label="Page navigation">
        <ul class="pagination mb-0">
            @{
                // Lấy Action hiện tại để tạo URL
                var currentAction = ViewContext.RouteData.Values["action"].ToString();
            }

            <li class="page-item @(Model.IsFirstPage ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action(currentAction, new { page = Model.PageNumber - 1 })"
                   aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action(currentAction, new { page = i })">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.IsLastPage ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action(currentAction, new { page = Model.PageNumber + 1 })"
                   aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
