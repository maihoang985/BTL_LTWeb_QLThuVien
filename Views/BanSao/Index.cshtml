@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<Library_Manager.Models.TBanSao>

@{
    ViewData["Title"] = "Danh sách bản sao";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    @* <h1 class="mb-3">Danh sách bản sao</h1> *@
    <h1 class="mb-3">
        Danh sách bản sao
        @if (ViewBag.TenTaiLieu != null)
        {
            <br />
            <span class="text-primary">(@ViewBag.TenTaiLieu)</span>
        }
    </h1>

    <!-- Thanh tìm kiếm -->
    <partial name="SearchBar" />

    <p>
        <a class="btn btn-success" asp-action="Create">+ Thêm bản sao</a>
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-nowrap align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tình trạng</th>
                    <th>Mã tài liệu</th>
                    <th>Tên tài liệu</th>
                    <th style="min-width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TinhTrang</td>
                            <td>@item.MaTl</td>
                            <td>@item.MaTlNavigation?.TenTl</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.MaBs">Sửa</a> |
                                <a asp-action="Details" asp-route-id="@item.MaBs">Chi tiết</a> |
                                <a asp-action="Delete" asp-route-id="@item.MaBs">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Không có dữ liệu</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang -->
        <partial name="_Pagination" />

        <div class="mt-4">
            <a asp-controller="TaiLieu" asp-action="Details" asp-route-id="@ViewBag?.MaTl" class="btn btn-secondary">
                <i class="bx bx-arrow-back"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>
