@model Library_Manager.Models.TBanSao

@{
    ViewData["Title"] = "Tạo bản sao";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h1>Tạo bản sao</h1>

    <h4>Thông tin bản sao</h4>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaBs" class="control-label">Mã bản sao</label>
                    <input asp-for="MaBs" class="form-control" />
                    <span asp-validation-for="MaBs" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaTl" class="control-label">Mã tài liệu</label>
                    <select asp-for="MaTl" class="form-control" asp-items="ViewBag.MaTl"></select>
                </div>

                <div class="form-group">
                    <label asp-for="TinhTrang" class="control-label">Tình trạng</label>
                    <input asp-for="TinhTrang" class="form-control" />
                    <span asp-validation-for="TinhTrang" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Tạo mới" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
