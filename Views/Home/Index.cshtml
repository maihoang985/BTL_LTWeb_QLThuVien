@* File: Views/Home/Index.cshtml (Thiết kế Gộp Khối và Tách Card mới) *@
@using Library_Manager.Models;
@using Microsoft.AspNetCore.Http;

@{
    ViewData["Title"] = "Tổng Quan Hệ Thống";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. KHAI BÁO & ÉP KIỂU TỪ VIEWBAG
    var account = ViewBag.CurrentAccount as TTaiKhoan;
    var employee = ViewBag.CurrentEmployee as TNhanVien;

    // Logic Lời chào theo thời gian
    string greeting = "Xin chào";
    int hour = DateTime.Now.Hour;
    if (hour >= 5 && hour < 11) { greeting = "Chào buổi sáng"; }
    else if (hour >= 11 && hour < 14) { greeting = "Chào buổi trưa"; }
    else if (hour >= 14 && hour < 18) { greeting = "Chào buổi chiều"; }
    else { greeting = "Chào buổi tối"; }

    // Logic cho Badge Vai Trò
    var vaiTro = account?.MaVtNavigation?.MaVt;
    var tenVaiTro = account?.MaVtNavigation?.TenVt;
    var badgeVaiTroClass = "bg-label-secondary";
    if (vaiTro == "QTV") { badgeVaiTroClass = "bg-label-primary"; }
    else if (vaiTro == "QLB") { badgeVaiTroClass = "bg-label-info"; }
    else if (vaiTro == "QLT") { badgeVaiTroClass = "bg-label-success"; }
    else if (vaiTro == "QLM") { badgeVaiTroClass = "bg-label-warning"; }

    // Logic cho Badge Giới tính
    var gioiTinh = (employee?.GioiTinh == "M" ? "Nam" : employee?.GioiTinh == "F" ? "Nữ" : "-");
    var badgeGioiTinhClass = gioiTinh == "Nam" ? "bg-label-info" :
                             gioiTinh == "Nữ" ? "bg-label-danger" :
                             "bg-label-secondary";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">

        <div class="col-lg-12 mb-4 order-0">
            <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Dashboard /</span> Tổng Quan Quản Trị (@tenVaiTro)</h4>
        </div>

        @* ========================================================================
           KHỐI 1: CÁ NHÂN, TÀI KHOẢN & TRUY CẬP CÁ NHÂN (FULL WIDTH)
           ======================================================================== *@
        @if (employee != null && account != null)
        {
            <div class="col-lg-12 mb-4 order-0">
                <div class="card p-3">
                    <div class="row">

                        <div class="col-lg-8 col-md-12 border-end">
                            <h5 class="text-primary mb-3"><i class='bx bxs-user-badge me-2'></i> @greeting, @employee.HoDem @employee.Ten!</h5>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <span class="d-block text-secondary">Mã NV:</span>
                                    <p class="fw-bold mb-0">@employee.MaNv</p>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="d-block text-secondary">Phụ trách:</span>
                                    <p class="fw-bold mb-0">@employee.PhuTrach</p>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="d-block text-secondary">Email:</span>
                                    <p class="mb-0">@employee.Email</p>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="d-block text-secondary">Giới tính:</span>
                                    <span class="badge @badgeGioiTinhClass">@gioiTinh</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-12 ps-lg-4 mt-md-3 mt-lg-0">
                            <h5 class="text-muted mb-3"><i class='bx bxs-key me-2'></i> Quyền truy cập</h5>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <span class="d-block text-secondary">Tên Đăng nhập:</span>
                                    <p class="fw-bold mb-0">@account.TenDangNhap</p>
                                </div>
                                <div class="col-6">
                                    <span class="d-block text-secondary">Vai trò:</span>
                                    <span class="badge @badgeVaiTroClass fs-6">@tenVaiTro</span>
                                </div>
                            </div>

                            <div class="d-grid">
                                <a href="@Url.Action("Details", "TaiKhoan", new { id = account.MaTk })" class="btn btn-sm btn-outline-secondary">
                                    <i class='bx bx-detail me-1'></i> Xem chi tiết Tài khoản
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @* --- KẾT THÚC KHỐI CÁ NHÂN --- *@


        @* ========================================================================
           KHỐI 2: QUẢN LÝ MƯỢN/TRẢ (COL-LG-6)
           ======================================================================== *@
        <div class="col-lg-12 mb-4">
            <div class="card h-100">
                <h5 class="card-header text-primary"><i class='bx bxs-check-square me-2'></i> Quản Lý Mượn/Trả</h5>
                <div class="card-body">
                    <div class="row">

                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-danger text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-danger">SÁCH QUÁ HẠN</h6>
                                    <h2 class="card-text">@ViewBag.OverdueLoans</h2>
                                    <small class="text-danger fw-semibold">Cần thu hồi ngay</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-warning text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-warning">TỔNG ĐANG MƯỢN</h6>
                                    <h2 class="card-text">@ViewBag.TotalLoans</h2>
                                    <small class="text-warning fw-semibold">GD trong ngày: +@ViewBag.LoansToday</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-primary text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-primary">XỬ LÝ GIAO DỊCH</h6>
                                    <a href="@Url.Action("Create", "GiaoDichMuonTra")" class="btn btn-primary mt-2"><i class='bx bx-barcode-reader me-1'></i> Bắt đầu</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <h6 class="text-danger mb-3 border-bottom pb-1"><i class='bx bx-list-ol me-1'></i> 5 Giao Dịch Quá Hạn Lâu Nhất</h6>
                            <div class="table-responsive">
                                <table class="table card-table table-sm">
                                    <tbody class="table-border-bottom-0">
                                        @foreach (var item in ViewBag.OverdueList)
                                        {
                                            <tr>
                                                <td><i class='bx bxs-book-reader me-2'></i> @item.TenSach</td>
                                                <td class="text-muted">@item.DocGia</td>
                                                <td class="text-end"><span class="badge bg-label-danger">@item.NgayHenTra</span></td>
                                            </tr>
                                        }
                                        @if (((List<dynamic>)ViewBag.OverdueList).Count == 0)
                                        {
                                            <tr><td colspan="3" class="text-center text-success fst-italic">Không có sách quá hạn.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <h6 class="text-primary mb-3 border-bottom pb-1"><i class='bx bx-time-five me-1'></i> 5 Hoạt Động Giao Dịch Gần Nhất</h6>
                            <div class="table-responsive">
                                <table class="table card-table table-sm">
                                    <tbody class="table-border-bottom-0">
                                        @foreach (var item in ViewBag.RecentTransactions)
                                        {
                                            var badgeClass = item.Loai == "Trả" ? "bg-label-success" : "bg-label-primary";
                                            <tr>
                                                <td><span class="badge @badgeClass me-2">@item.Loai</span> @item.DocGia</td>
                                                <td class="text-end text-muted">@item.ThoiGian</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end bg-transparent border-top">
                    <a href="@Url.Action("Index", "GiaoDichMuonTra")" class="btn btn-sm btn-primary">Xem tất cả Giao dịch <i class='bx bx-right-arrow-alt'></i></a>
                </div>
            </div>
        </div>


        @* ========================================================================
           KHỐI 3: QUẢN LÝ TÀI LIỆU (FULL WIDTH)
           ======================================================================== *@
        <div class="col-lg-12 mb-4">
            <div class="card h-100">
                <h5 class="card-header text-info"><i class='bx bxs-box me-2'></i> Quản Lý Tài Liệu (Kho)</h5>
                <div class="card-body">
                    <div class="row">

                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-warning text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-warning">ĐẦU SÁCH CẦN NHẬP</h6>
                                    <h2 class="card-text">@ViewBag.LowStockCount</h2>
                                    <small class="text-warning fw-semibold">Tồn kho < 3 bản</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-success text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-success">BẢN SÁCH SẴN SÀNG</h6>
                                    <h2 class="card-text">@ViewBag.AvailableCopies</h2>
                                    <small class="text-success fw-semibold">Tổng: @ViewBag.TotalCopies</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-info text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-info">NHẬP LIỆU NHANH</h6>
                                    <a href="@Url.Action("Create", "TaiLieu")" class="btn btn-info mt-2">Thêm Tài liệu mới</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <h6 class="text-warning mb-3 border-bottom pb-1"><i class='bx bx-alarm-exclamation me-1'></i> 5 Tài Liệu Cần Bổ Sung Gấp</h6>
                            <div class="table-responsive">
                                <table class="table card-table table-sm">
                                    <tbody class="table-border-bottom-0">
                                        @foreach (var item in ViewBag.LowStockList)
                                        {
                                            <tr>
                                                <td><i class='bx bx-book me-2'></i> @item.TenTl</td>
                                                <td><span class="badge @(item.SoBanSanSang == 0 ? "bg-label-danger" : "bg-label-warning") me-1">@item.SoBanSanSang bản</span></td>
                                                <td class="text-end"><a href="@Url.Action("Edit", "TaiLieu", new { id = item.MaTl })" class="text-primary">Xem / Nhập</a></td>
                                            </tr>
                                        }
                                        @if (((List<dynamic>)ViewBag.LowStockList).Count == 0)
                                        {
                                            <tr><td colspan="3" class="text-center text-success fst-italic">Tất cả tài liệu đều đủ tồn kho.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <h6 class="text-info mb-3 border-bottom pb-1"><i class='bx bx-category-alt me-1'></i> Tổng Quan Kho</h6>
                            <div class="alert alert-light text-center fst-italic">
                                Thêm biểu đồ phân bố Ngôn ngữ/Định dạng ở đây (nếu có dữ liệu).
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end bg-transparent border-top">
                    <a href="@Url.Action("Index", "TaiLieu")" class="btn btn-sm btn-info">Quản lý Tài liệu <i class='bx bx-right-arrow-alt'></i></a>
                </div>
            </div>
        </div>

        @* ========================================================================
           KHỐI 4: QUẢN LÝ BẠN ĐỌC (FULL WIDTH)
           ======================================================================== *@
        <div class="col-lg-12 mb-4">
            <div class="card">
                <h5 class="card-header text-success"><i class='bx bxs-group me-2'></i> Quản Lý Bạn Đọc</h5>
                <div class="card-body">
                    <div class="row">

                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-danger text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-danger">THẺ BẠN ĐỌC BỊ KHÓA</h6>
                                    <h2 class="card-text">@ViewBag.LockedReaders</h2>
                                    <small class="text-danger fw-semibold">Cần giải quyết vi phạm</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-primary text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-primary">TỔNG ĐỘC GIẢ</h6>
                                    <h2 class="card-text">@ViewBag.TotalReaders</h2>
                                    <small class="text-primary fw-semibold">Thành viên mới: +5</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="card bg-label-success text-center">
                                <div class="card-body">
                                    <h6 class="card-title text-success">ĐĂNG KÝ MỚI</h6>
                                    <a href="@Url.Action("Create", "BanDoc")" class="btn btn-success mt-2">Đăng ký độc giả</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <h6 class="text-primary mb-3 border-bottom pb-1"><i class='bx bx-user-pin me-1'></i> 5 Độc Giả Mới Nhất</h6>
                            <div class="table-responsive">
                                <table class="table card-table table-sm">
                                    <tbody class="table-border-bottom-0">
                                        @foreach (var item in ViewBag.NewReadersList)
                                        {
                                            <tr>
                                                <td><i class='bx bx-user me-2'></i> @item.Ten</td>
                                                <td class="text-end text-muted">
                                                    @if (item.NgayTao != null)
                                                    {
                                                        @(((DateTime)item.NgayTao).ToString("dd/MM/yyyy"))
                                                    }
                                                    else
                                                    {
                                                        @:N/A
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-lg-6 mb-4">
                            <h6 class="text-danger mb-3 border-bottom pb-1"><i class='bx bx-calendar-x me-1'></i> Thẻ Độc Giả Sắp/Đã Hết Hạn</h6>
                            <div class="alert alert-light text-center fst-italic">
                                Thêm danh sách thẻ độc giả sắp hết hạn (cần truy vấn mới) ở đây.
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end bg-transparent border-top">
                    <a href="@Url.Action("Index", "BanDoc")" class="btn btn-sm btn-success">Quản lý Bạn đọc <i class='bx bx-right-arrow-alt'></i></a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
}