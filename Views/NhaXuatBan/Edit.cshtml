@model Library_Manager.Models.TNhaXuatBan

@{
    // Đặt tiêu đề cho trang
    ViewData["Title"] = "Chỉnh sửa Nhà Xuất Bản: " + Model.TenNxb;

    // Logic kiểm tra quyền chỉnh sửa (Giả định QTV/QLS có quyền)
    var userRole = Context.Session.GetString("UserRole");
    bool canEdit = (userRole == "QTV" || userRole == "QLS");
}

@* ========================================================================
   KHỐI 1: CẤU TRÚC BỐ CỤC CHÍNH (CONTAINER)
   ======================================================================== *@
<div class="container-xxl flex-grow-1 container-p-y">

    @* --- PHẦN 1.1: TIÊU ĐỀ TRANG --- *@
    <h1 class="fw-bold text-primary mb-4">
        <i class='bx bx-pencil fs-2 me-2'></i> Chỉnh sửa Nhà Xuất Bản
    </h1>

    @* --- KHỐI: CARD BAO QUANH FORM --- *@
    <div class="card">

        @* HEADER CỦA CARD: Hiển thị tên Nhà Xuất Bản đang chỉnh sửa *@
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                Chỉnh sửa thông tin Nhà Xuất Bản: <span class="text-primary fw-bold">@Model.TenNxb</span>
            </h5>
            <small class="text-muted">Mã NXB: <span class="fw-bold">@Model.MaNxb</span></small>
        </div>

        @* FORM BẮT ĐẦU *@
        <form asp-action="Edit">
            @* BODY CỦA CARD: CHỨA CÁC TRƯỜNG DỮ LIỆU *@
            <div class="card-body">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* 1. Mã NXB (Ẩn và Hiển thị không sửa) *@
                @* Trường ẩn (MaNxb) để đảm bảo giá trị được gửi lên Controller *@
                <input type="hidden" asp-for="MaNxb" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Mã Nhà Xuất Bản</label>
                            @* Hiển thị MaNxb dưới dạng không sửa đổi (disabled) *@
                            <input value="@Model.MaNxb" class="form-control" disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    @* 2. Tên NXB *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="TenNxb" class="form-label">Tên Nhà Xuất Bản</label>
                            <input asp-for="TenNxb" class="form-control" />
                            <span asp-validation-for="TenNxb" class="text-danger"></span>
                        </div>
                    </div>
                </div>

            </div>

            @* FOOTER CỦA CARD: Chứa các nút Hành động *@
            <div class="card-footer border-top pt-3">
                <div class="d-flex gap-3">
                    @* Nút Lưu *@
                    <button type="submit" value="Save" class="btn btn-primary @(canEdit ? "" : "disabled")">
                        <i class="bx bx-save me-1"></i> Lưu thay đổi
                    </button>

                    @* Nút Quay lại *@
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        // Đảm bảo Validation Script được render
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
