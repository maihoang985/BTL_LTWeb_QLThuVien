
@model Library_Manager.Models.TTaiKhoan

@{
    ViewData["Title"] = "Chi tiết tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h2 class="mb-4 text-primary">Chi tiết tài khoản</h2>

    <div class="card shadow-sm p-4">
        <h5 class="card-title mb-3 text-secondary">Thông tin tài khoản</h5>
        <div class="table-responsive">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 25%;">Tên đăng nhập</th>
                        <td>@Html.DisplayFor(model => model.TenDangNhap)</td>
                    </tr>
                    <tr>
                        <th>Mật khẩu</th>
                        <td>@Html.DisplayFor(model => model.MatKhau)</td>
                    </tr>
                    <tr>
                        <th>Trạng thái</th>
                        <td>
                            @Html.DisplayFor(model => model.TrangThai)
                        </td>
                    </tr>
                    <tr>
                        <th>Ngày tạo</th>
                        <td>@Html.DisplayFor(model => model.NgayTao)</td>
                    </tr>
                    <tr>
                        <th>Mã nhân viên</th>
                        <td>
                            @Html.DisplayFor(model => model.MaNvNavigation.MaNv)
                            <a asp-controller="NhanVien"
                               asp-action="Details"
                               asp-route-id="@Model.MaNvNavigation.MaNv"
                               class="btn btn-sm btn-info ms-2">
                                <i class="bx bx-user"></i> Xem nhân viên
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <th>Vai trò</th>
                        <td>@Html.DisplayFor(model => model.MaVtNavigation.MaVt)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.MaTk" class="btn btn-warning me-2">
            <i class="bx bx-edit"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bx bx-arrow-back"></i> Quay lại danh sách
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
