@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<Library_Manager.Models.TTaiKhoan>



@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h1 class="mb-3">Danh sách tài khoản</h1>
    <partial name="SearchBar" />
    <p>
        <a class="btn btn-success" asp-action="Create">+ Thêm tài khoản</a>
    </p>
<div class="table-responsive">
    <table class="table table-bordered table-striped text-nowrap align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên đăng nhập</th>
                <th>Mật khẩu</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Mã nhân viên</th>
                <th>Vai trò</th>
                <th style="min-width: 120px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TenDangNhap</td>
                        <td>@item.MatKhau</td>
                        <td>@item.TrangThai</td>
                        <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                        <td>@item.MaNvNavigation?.MaNv</td>
                        <td>@item.MaVtNavigation?.MaVt</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MaTk">Sửa</a> |
                            <a asp-action="Details" asp-route-id="@item.MaTk">Chi tiết</a> |
                            <a asp-action="Delete" asp-route-id="@item.MaTk">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
        <partial name="_Pagination" />
  </div>


