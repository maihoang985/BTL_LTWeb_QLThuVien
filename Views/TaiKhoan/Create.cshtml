@model Library_Manager.Models.TTaiKhoan

@{
    ViewData["Title"] = "Tạo tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h1>Tạo tài khoản</h1>

    <h4>Thông tin tài khoản</h4>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaTk" class="control-label">Mã tài khoản</label>
                    <input asp-for="MaTk" class="form-control" />
                    <span asp-validation-for="MaTk" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaNv" class="control-label">Nhân viên</label>
                    <select asp-for="MaNv" class="form-control" asp-items="ViewBag.MaNv"></select>
                </div>

                <div class="form-group">
                    <label asp-for="MaVt" class="control-label">Vai trò</label>
                    <select asp-for="MaVt" class="form-control" asp-items="ViewBag.MaVt"></select>
                </div>

                <div class="form-group">
                    <label asp-for="TenDangNhap" class="control-label">Tên đăng nhập</label>
                    <input asp-for="TenDangNhap" class="form-control" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MatKhau" class="control-label">Mật khẩu</label>
                    <input asp-for="MatKhau" class="form-control" type="password" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TrangThai" class="control-label">Trạng thái</label>
                    <input asp-for="TrangThai" class="form-control" />
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NgayTao" class="control-label">Ngày tạo</label>
                    <input asp-for="NgayTao" class="form-control" type="date" />
                    <span asp-validation-for="NgayTao" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Tạo mới" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
